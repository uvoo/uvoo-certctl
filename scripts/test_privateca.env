set -a
# Private CA test variables for uvoocertctl
CERTCTL_BIN=./uvoocertctl
CERT_DB=./certs.db
RESET_DB=1
CREATE_NEW=1

# Reuse IDs when CREATE_NEW=0
ROOT_ID=
ICA_ID=

# Names / subjects
ROOT_NAME=corp-root-1
ROOT_CN="Corp Root CA 1"
ICA_NAME=corp-ica-1
ICA_CN="Corp Intermediate CA 1"
SERVER_CERT_CN=host1.example.internal
CLIENT_CERT_CN=client1.example.internal

# Validity
ROOT_DAYS=3650
ICA_DAYS=1825
LEAF_DAYS=825

# Key types
ROOT_KEY_TYPE=ec256
ICA_KEY_TYPE=ec256
SERVER_KEY_TYPE=ec256
CLIENT_KEY_TYPE=ed25519

# Passwords
ROOT_KEY_PASSWORD=root-secret-please-changeA1
ICA_KEY_PASSWORD=ica-secret-please-changeA1
SERVER_KEY_PASSWORD=leaf-server-secret-please-changeA1
CLIENT_KEY_PASSWORD=leaf-client-secret-please-changeA1
EXPORT_PASSWORD=bundlepass-please-changeA1

# Optional fallback password
STORAGE_PASSWORD=

# Subject fields
ORG=Uvoo
ORG_UNIT=Platform
COUNTRY=US
PROVINCE=Utah
LOCALITY="Salt Lake City"

# Space-separated SANs
SERVER_SANS="host1.example.internal host1 10.10.10.15"
CLIENT_SANS="client1.example.internal"

EXPORT_DIR=./out-privateca
set +a
